    "onMount",
    "onReady",
    "onDestroy"
  ],
  "entry": "module.js",
  "files": {
    "module": "module.js",
    "config": "config.js",
    "state": "state.js",
    "service": "service.js",
    "events": "events.js",
    "view": "view.js",
    "manifest": "manifest.json"
