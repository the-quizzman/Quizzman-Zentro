{
  "name": "sample",
  "version": "1.0.0",
  "description": "Sample module",
  "layer": "module",
  "dependencies": [],
  "services": [
    {
      "id": "main",
      "token": "svc:sample.main",
      "file": "service.js",
      "singleton": true
    }
  ],
  "events": {
    "produces": [
      {
        "name": "sample.ready",
        "version": 1,
        "schema": "SampleReadyPayload"
      }
