{
  "name": "auth",
  "version": "1.0.0",
  "description": "Session bootstrap and auth.session.changed producer.",
  "layer": "module",
  "dependencies": [],
  "services": [
    {
      "id": "session",
      "token": "svc:auth.session",
      "file": "service.js",
      "singleton": true
    }
  ],
  "events": {
    "produces": [
      {
        "name": "auth.session.changed",
        "version": 1,
        "schema": "AuthSessionChangedPayload"
      }
    ],
    "consumes": []
  },
  "states": [
    {
      "id": "auth",
      "file": "state.js",
      "schema": "StateSchema",
      "scope": "module"
    }
  ],
  "permissions": ["auth:session"],
  "exports": {
    "plugin": "module.js",
    "public": []
  },
  "configSchema": "ConfigSchema",
  "lifecycle": ["onInit", "onMount", "onConnect", "onReady", "onDestroy"],
  "entry": "module.js",
  "files": {
    "module": "module.js",
    "config": "config.js",
    "state": "state.js",
    "service": "service.js",
    "events": "events.js",
    "view": "view.js",
    "manifest": "manifest.json"
  }
}
