{
  "name": "@qmf/migrate",
  "version": "1.0.1",
  "description": "QMF v2 to v3 migration tool",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "browser": "dist/qmf-migrate.min.js",
  "types": "dist/index.d.ts",
  "bin": {
    "qmf-migrate": "./bin/qmf-migrate.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "browser": "./dist/qmf-migrate.min.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "keywords": [
    "qmf",
    "migration",
    "codemod",
    "refactoring"
  ],
  "author": "Quizzman",
  "license": "MIT",
  "dependencies": {
    "glob": "^10.5.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
