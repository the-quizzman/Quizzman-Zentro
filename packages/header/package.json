{
  "name": "@qmf/header",
  "version": "3.0.1",
  "description": "QMF Header Module - Unified 3-zone header with branding, social buttons, user dropdown",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/style.css",
    "./css": "./dist/style.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && cp src/*.css dist/",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@qmf/core": "^3.0.0",
    "@qmf/tokens": "^3.0.0",
    "@qmf/utils": "^3.0.0",
    "@qmf/ui": "^3.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@qmf/core": "^3.0.0",
    "@qmf/tokens": "^3.0.0",
    "@qmf/utils": "^3.0.0",
    "@qmf/ui": "^3.0.0",
    "zod": "^3.22.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
