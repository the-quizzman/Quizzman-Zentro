{
  "name": "@qmf/loading-screen",
  "version": "3.0.1",
  "description": "QMF Loading Screen \u2013 fullscreen splash with progress, particles, dark/light themes",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/style.css"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup && cp src/*.css dist/",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@qmf/core": "^3.0.0",
    "@qmf/tokens": "^3.0.0",
    "@qmf/utils": "^3.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@qmf/core": "^3.0.0",
    "@qmf/tokens": "^3.0.0",
    "@qmf/utils": "^3.0.0",
    "zod": "^3.22.0",
    "typescript": "^5.4.0",
    "tsup": "^8.0.0"
  },
  "private": true
}