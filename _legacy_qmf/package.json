{
    "name": "qmf",
    "version": "2.0.0",
    "description": "Quizzman Modular Framework - App Shell + UI Kit",
    "main": "dist/qmf.bundle.js",
    "module": "kernel/index.js",
    "type": "module",
    "scripts": {
        "dev": "node scripts/build.js --watch",
        "build": "node scripts/build.js",
        "build:prod": "NODE_ENV=production node scripts/build.js",
        "serve": "npx serve dist -p 9999",
        "lint": "eslint kernel/ plugins/ services/",
        "test": "vitest"
    },
    "dependencies": {
        "socket.io-client": "^4.7.0"
    },
    "devDependencies": {
        "esbuild": "^0.20.0",
        "eslint": "^8.56.0",
        "vitest": "^1.2.0"
    },
    "browserslist": [
        "> 1%",
        "last 2 versions",
        "not dead"
    ],
    "files": [
        "dist/",
        "kernel/",
        "plugins/",
        "services/",
        "assets/",
        "manifest.json"
    ],
    "author": "Quizzman Team",
    "license": "UNLICENSED",
    "private": true
}
