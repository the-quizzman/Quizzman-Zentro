#!/bin/bash
# =============================================================
# QMF Source Minification Script
# Minifies all JS/CSS in dist/ to protect QMF intellectual property
# Note: /opt/Quizzman/qmf is a symlink to /opt/Quizzman/QMF
#       so changes apply to both paths automatically.
#
# Usage:
#   bash qmf-minify.sh           # Minify all source files
#   bash qmf-minify.sh --restore # Restore original sources
# =============================================================
set -uo pipefail

QMF_DIR="/opt/Quizzman/QMF"
DIST_DIR="$QMF_DIR/dist"
SRC_BACKUP="$QMF_DIR/_src"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

log()  { echo -e "${GREEN}[QMF]${NC} $1"; }
warn() { echo -e "${YELLOW}[QMF]${NC} $1"; }
err()  { echo -e "${RED}[QMF]${NC} $1"; }

# --- Restore mode ---
if [[ "${1:-}" == "--restore" ]]; then
    if [[ ! -d "$SRC_BACKUP" ]]; then
        err "No backup found at $SRC_BACKUP"; exit 1
    fi
    log "Restoring original sources from backup..."
    cd "$SRC_BACKUP"
    find . -type f -exec sh -c '
        for f; do
            dest="'"$DIST_DIR"'/$f"
            mkdir -p "$(dirname "$dest")"
            cp "$f" "$dest"
        done' _ {} +
    log "Restore complete."
    exit 0
fi

# --- Check dependencies ---
command -v terser >/dev/null 2>&1 || { err "terser not found"; exit 1; }
command -v cleancss >/dev/null 2>&1 || { err "clean-css not found"; exit 1; }

# --- Backup original sources ---
if [[ ! -d "$SRC_BACKUP" ]]; then
    log "Backing up original sources to $SRC_BACKUP..."
    mkdir -p "$SRC_BACKUP"
    cd "$DIST_DIR"
    find . -type f \( -name "*.js" -o -name "*.css" -o -name "*.cjs" \) \
        ! -name "*.min.js" ! -name "*.min.css" ! -name "*.cdn.min.js" \
        -exec sh -c '
        for f; do
            mkdir -p "'"$SRC_BACKUP"'/$(dirname "$f")"
            cp "$f" "'"$SRC_BACKUP"'/$f"
        done' _ {} +
    log "Backup complete."
else
    warn "Backup exists at $SRC_BACKUP, skipping backup."
fi

JS_OK=0; JS_FAIL=0; CSS_OK=0; CSS_FAIL=0

# --- Minify JS/CJS files ---
# Use cat>file pattern to preserve inode (important for symlinks)
log "Minifying JavaScript files..."
while IFS= read -r -d '' jsfile; do
    base=$(basename "$jsfile")
    [[ "$base" == *.min.js || "$base" == *.cdn.min.js ]] && continue

    tmpfile=$(mktemp)
    if terser "$jsfile" --compress "drop_console=false,passes=2" --mangle --output "$tmpfile" 2>/dev/null; then
        cat "$tmpfile" > "$jsfile"
        rm -f "$tmpfile"
        log "  OK: ${jsfile#$DIST_DIR/}"
        JS_OK=$((JS_OK + 1))
    elif terser "$jsfile" --compress --mangle --output "$tmpfile" 2>/dev/null; then
        cat "$tmpfile" > "$jsfile"
        rm -f "$tmpfile"
        log "  OK: ${jsfile#$DIST_DIR/}"
        JS_OK=$((JS_OK + 1))
    else
        rm -f "$tmpfile"
        err "  FAIL: ${jsfile#$DIST_DIR/}"
        JS_FAIL=$((JS_FAIL + 1))
    fi
done < <(find "$DIST_DIR" -type f \( -name "*.js" -o -name "*.cjs" \) -print0 | sort -z)

# --- Minify CSS files ---
log "Minifying CSS files..."
while IFS= read -r -d '' cssfile; do
    base=$(basename "$cssfile")
    [[ "$base" == *.min.css ]] && continue

    tmpfile=$(mktemp)
    if cleancss -o "$tmpfile" "$cssfile" 2>/dev/null && [[ -s "$tmpfile" ]]; then
        cat "$tmpfile" > "$cssfile"
        rm -f "$tmpfile"
        log "  OK: ${cssfile#$DIST_DIR/}"
        CSS_OK=$((CSS_OK + 1))
    else
        rm -f "$tmpfile"
        err "  FAIL: ${cssfile#$DIST_DIR/}"
        CSS_FAIL=$((CSS_FAIL + 1))
    fi
done < <(find "$DIST_DIR" -type f -name "*.css" -print0 | sort -z)

# --- Remove source maps ---
log "Removing source map files..."
MAP_COUNT=$(find "$DIST_DIR" -type f -name "*.map" | wc -l)
find "$DIST_DIR" -type f -name "*.map" -delete
log "  Removed $MAP_COUNT map files."

# --- Strip sourceMappingURL comments ---
log "Stripping sourceMappingURL references..."
find "$DIST_DIR" -type f \( -name "*.js" -o -name "*.css" -o -name "*.cjs" \) -print0 | \
    xargs -0 grep -l 'sourceMappingURL' 2>/dev/null | while IFS= read -r f; do
        sed -i '/sourceMappingURL/d' "$f"
        log "  Stripped: ${f#$DIST_DIR/}"
    done

echo ""
log "========================================="
log "  QMF Minification Complete"
log "  JS/CJS: $JS_OK ok, $JS_FAIL fail"
log "  CSS:    $CSS_OK ok, $CSS_FAIL fail"
log "  Maps:   $MAP_COUNT removed"
log "  Backup: $SRC_BACKUP"
log "========================================="
log "To restore: bash $0 --restore"
