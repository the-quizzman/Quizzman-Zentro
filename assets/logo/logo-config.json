{
  "version": "1.0.0",
  "description": "Logo configuration for Quizzman subsystems",
  "cdnBase": "https://ui.quizzman.com/qmf/assets/logo",
  
  "default": {
    "logo": "quizzman-logo.png",
    "logoOnLightSurface": "quizzman-logo-116.webp",
    "logoOnDarkSurface": "quizzman-logo-116.webp",
    "logoDarkLegacyWordmark": "quizzman-logo-dark.png",
    "logoDark": "quizzman-logo-dark.png",
    "logoLoading": "quizzman-logo-loading.png",
    "logoWebp": "quizzman-logo-116.webp",
    "logoDarkWebp": "quizzman-logo-dark-116.webp",
    "logoLoadingWebp": "quizzman-logo-loading-116.webp",
    "favicon": "favicon-32.png",
    "faviconDark": "favicon-dark-32.png",
    "faviconIco": "favicon.ico",
    "appleTouchIcon": "apple-touch-icon.png",
    "sizes": [32, 64, 128, 256, 512]
  },
  
  "subsystems": {
    "classroom": {
      "hasCustomLogo": true,
      "logo": "classroom/classroom-logo.png",
      "favicon": "classroom/favicon.ico",
      "sizes": {
        "32": "classroom/classroom-logo-32.png",
        "64": "classroom/classroom-logo-64.png",
        "128": "classroom/classroom-logo-128.png",
        "256": "classroom/classroom-logo-256.png",
        "512": "classroom/classroom-logo-512.png"
      }
    },
    "lms": {
      "hasCustomLogo": true,
      "logo": "lms/lms-logo.png",
      "favicon": "lms/favicon.ico",
      "sizes": {
        "32": "lms/lms-logo-32.png",
        "64": "lms/lms-logo-64.png",
        "128": "lms/lms-logo-128.png",
        "256": "lms/lms-logo-256.png",
        "512": "lms/lms-logo-512.png"
      }
    },
    "play": {
      "hasCustomLogo": true,
      "logo": "play/play-logo.png",
      "favicon": "play/favicon.ico",
      "appleTouchIcon": "play/apple-touch-icon.png",
      "sizes": {
        "16": "play/favicon-16x16.png",
        "32": "play/play-logo-32.png",
        "64": "play/play-logo-64.png",
        "128": "play/play-logo-128.png",
        "256": "play/play-logo-256.png",
        "512": "play/android-chrome-512x512.png"
      }
    },
    "iching": {
      "hasCustomLogo": true,
      "logo": "iching/iching-logo.png",
      "favicon": "iching/favicon-iching.ico",
      "sizes": {
        "32": "iching/iching-logo-32.png",
        "64": "iching/iching-logo-64.png",
        "128": "iching/iching-logo-128.png",
        "256": "iching/iching-logo-256.png"
      }
    },
    "calendar": {
      "hasCustomLogo": true,
      "logo": "calendar/calendar-logo.png",
      "favicon": "calendar/favicon-calendar.ico",
      "sizes": {
        "32": "calendar/calendar-logo-32.png",
        "64": "calendar/calendar-logo-64.png",
        "128": "calendar/calendar-logo-128.png",
        "256": "calendar/calendar-logo-256.png"
      }
    },
    "webmail": {
      "hasCustomLogo": true,
      "logo": "webmail/webmail-logo.png",
      "favicon": "webmail/favicon.ico",
      "sizes": {
        "32": "webmail/webmail-logo-32.png",
        "64": "webmail/webmail-logo-64.png",
        "128": "webmail/webmail-logo-128.png",
        "256": "webmail/webmail-logo-256.png",
        "512": "webmail/webmail-logo-512.png"
      }
    },
    "nav": {
      "hasCustomLogo": true,
      "description": "Compressed header mega-menu thumbnails (40/80 + webp)",
      "cdnPath": "nav",
      "version": "20260718",
      "items": {
        "slide-studio": { "40": "nav/slide-studio-40.webp", "80": "nav/slide-studio-80.webp", "png40": "nav/slide-studio-40.png" },
        "quiz-editor": { "40": "nav/quiz-editor-40.webp", "80": "nav/quiz-editor-80.webp", "png40": "nav/quiz-editor-40.png" },
        "wiki": { "40": "nav/wiki-40.webp", "80": "nav/wiki-80.webp", "png40": "nav/wiki-40.png" },
        "idiom-king": { "40": "nav/idiom-king-40.webp", "80": "nav/idiom-king-80.webp", "png40": "nav/idiom-king-40.png" },
        "pikahans": { "40": "nav/pikahans-40.webp", "80": "nav/pikahans-80.webp", "png40": "nav/pikahans-40.png" }
      }
    },
    "id": {
      "hasCustomLogo": false,
      "useDefault": true
    },
    "main": {
      "hasCustomLogo": false,
      "useDefault": true
    },
    "admin": {
      "hasCustomLogo": false,
      "useDefault": true
    },
    "api": {
      "hasCustomLogo": false,
      "useDefault": true
    }
  },
  
  "usage": {
    "html": "<link rel=\"icon\" href=\"{{cdnBase}}/{{favicon}}\">\n<img src=\"{{cdnBase}}/{{logo}}\" alt=\"Logo\">",
    "js": "const logo = await fetch('/qmf/assets/logo/logo-config.json').then(r => r.json());"
  }
}
